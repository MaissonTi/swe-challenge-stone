  "info": {
    "title": "Stone Challenge API",
    "description": "Authentication (JWT RS256 with rotating refresh, reuse detection, and\nrevocation via a Redis blacklist) and a protected product catalog,\ncursor-paginated and filterable by category and name prefix.\n\nEvery route goes through a distributed rate limit (sliding window in\nRedis): exceeding it returns `429` with a `Retry-After` header.\nThe rationale behind each decision is in `docs/PRD.md`.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "auth",
      "description": "Registration, login, rotating refresh, logout, and user profile"
    },
    {
      "name": "products",
      "description": "CRUD and paginated/filterable catalog listing (protected route)"
    },
    {
      "name": "health",
      "description": "Liveness check (public route)"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local (dev)"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "messages": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "path",
                "messages"
              ]
            }
          }
        },
        "required": [
          "statusCode",
          "message"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "pattern": "^\\S+$"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "TokenResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "accessToken",
