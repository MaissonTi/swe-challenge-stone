          "429": {
            "description": "Rate limit exceeded. The `Retry-After` header gives the number of seconds to wait. Default limit is 100 requests/minute per identity (user id when authenticated, client IP otherwise) and route.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "products"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "delete": {
        "operationId": "ProductsController_delete",
        "summary": "Permanently delete a product",
        "description": "Physical removal, independent of `active`. Idempotent.",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Product id",
            "schema": {
              "type": "string",
