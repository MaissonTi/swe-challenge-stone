                  "$ref": "#/components/schemas/ProfileResponseDto"
                },
                "example": {
                  "userId": "3f1c2d4e-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
                  "email": "demo@stone.com.br",
                  "createdAt": "2026-01-15T12:34:56.000Z"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, or revoked access token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded. The `Retry-After` header gives the number of seconds to wait. Default limit is 100 requests/minute per identity (user id when authenticated, client IP otherwise) and route.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/v1/products": {
      "post": {
        "operationId": "ProductsController_create",
        "summary": "Create a product (active by default)",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
