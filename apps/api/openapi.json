      "get": {
        "operationId": "ProductsController_list",
        "summary": "List active products (paginated, filterable)",
        "description": "Cursor-based pagination - pass the previous page's `nextCursor` back as `cursor` to get the next page. `name` matches a case-insensitive prefix, not a substring.",
        "parameters": [
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "Opaque token from a previous page",
            "schema": {}
          },
          {
            "name": "name",
            "required": false,
            "in": "query",
            "description": "Case-insensitive name prefix",
            "schema": {}
          },
          {
            "name": "category",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "ELECTRONICS",
                "CLOTHING",
                "HOME",
                "BOOKS",
                "TOYS",
                "FOOD",
                "OTHER"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of active products",
            "example": {
              "items": [
                {
                  "id": "3f1c2d4e-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
                  "name": "Gaming Laptop 16GB",
                  "category": "ELECTRONICS",
                  "active": true,
                  "createdAt": "2026-01-15T12:34:56.000Z",
                  "updatedAt": "2026-01-15T12:34:56.000Z"
                }
              ],
              "nextCursor": "eyJwcm9kdWN0SWQiOiIzZjFjMmQ0ZS01YTZiLTRjN2QtOGU5Zi0wYTFiMmMzZDRlNWYifQ"
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListProductsResponseDto"
                },
                "example": {
                  "items": [
                    {
                      "id": "3f1c2d4e-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
                      "name": "Gaming Laptop 16GB",
                      "category": "ELECTRONICS",
                      "active": true,
                      "createdAt": "2026-01-15T12:34:56.000Z",
                      "updatedAt": "2026-01-15T12:34:56.000Z"
                    }
                  ],
                  "nextCursor": "eyJwcm9kdWN0SWQiOiIzZjFjMmQ0ZS01YTZiLTRjN2QtOGU5Zi0wYTFiMmMzZDRlNWYifQ"
                }
              }
            }
          },
          "400": {
            "description": "Invalid category value",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, or revoked access token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded. The `Retry-After` header gives the number of seconds to wait. Default limit is 100 requests/minute per identity (user id when authenticated, client IP otherwise) and route.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "tags": [
