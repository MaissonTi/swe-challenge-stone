        "responses": {
          "204": {
            "description": "Logged out"
          },
          "401": {
            "description": "Missing, expired, or revoked access token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded. The `Retry-After` header gives the number of seconds to wait. Default limit is 100 requests/minute per identity (user id when authenticated, client IP otherwise) and route.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/v1/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "summary": "Get the current authenticated user",
        "description": "Returns the profile of the user the access token belongs to.",
        "parameters": [],
        "responses": {
