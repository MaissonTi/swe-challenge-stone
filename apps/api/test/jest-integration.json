{
  "rootDir": "..",
  "testEnvironment": "node",
  "testMatch": ["<rootDir>/test/integration/**/*.integration-spec.ts"],
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  },
  "setupFiles": ["<rootDir>/test/setup-env.ts"],
  "testTimeout": 15000,
  "forceExit": true
}
