# HTTP
PORT=3000

# DynamoDB (LocalStack in dev)
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
USERS_TABLE_NAME=Users
PRODUCTS_TABLE_NAME=Products

# Redis
REDIS_URL=redis://localhost:6379

# JWT (RS256 key pair, PEM format - generate with: npm run generate:keys)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=604800

# OpenTelemetry (tracing exporter - Jaeger OTLP HTTP receiver in dev)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Reverse proxy hops to trust (Express `trust proxy`) when resolving the
# real client IP for rate-limiting anonymous routes. 0 = trust no proxy -
# correct for local dev and for the current deployment (no load balancer
# provisioned yet). Set to the real hop count once compute/network
# topology is decided (see docs/PRD.md, cloud infra roadmap).
TRUST_PROXY_HOPS=0
